"""Type surface for the SpiceyPy 8.3.0 APIs used by rotation captures."""

from collections.abc import Sequence
from ctypes import CDLL
from typing import Any

from numpy.typing import NDArray
from typing_extensions import TypeAlias

_FloatArray: TypeAlias = NDArray[Any]
_FloatSequence: TypeAlias = Sequence[float] | _FloatArray

__file__: str
__version__: str
libspice: CDLL

def axisar(axis: _FloatSequence, angle: float) -> _FloatArray: ...
def eul2m(
    angle3: float, angle2: float, angle1: float, axis3: int, axis2: int, axis1: int
) -> _FloatArray: ...
def m2eul(
    matrix: _FloatArray, axis3: int, axis2: int, axis1: int
) -> tuple[float, float, float]: ...
def m2q(matrix: _FloatArray) -> _FloatArray: ...
def mxv(matrix: _FloatArray, vector: _FloatSequence) -> _FloatArray: ...
def q2m(quaternion: _FloatSequence) -> _FloatArray: ...
def qdq2av(quaternion: _FloatArray, derivative: _FloatArray) -> _FloatArray: ...
def qxq(lhs: _FloatSequence, rhs: _FloatSequence) -> _FloatArray: ...
def raxisa(matrix: _FloatArray) -> tuple[_FloatArray, float]: ...
def tkvrsn(item: str) -> str: ...
