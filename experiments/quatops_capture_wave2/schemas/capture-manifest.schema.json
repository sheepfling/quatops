{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quatops/capture-manifest.schema.json",
  "title": "QuatOps native/spec/reference capture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "oracle_id",
    "oracle_family",
    "evidence_kind",
    "product",
    "execution",
    "precision",
    "exporter",
    "corpus",
    "artifacts",
    "coverage",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "capture_id": {
      "type": "string",
      "minLength": 1
    },
    "oracle_id": {
      "type": "string",
      "minLength": 1
    },
    "oracle_family": {
      "type": "string",
      "minLength": 1
    },
    "evidence_kind": {
      "enum": [
        "native_runtime",
        "upstream_static",
        "derived_reference",
        "spec_contract",
        "not_executed"
      ]
    },
    "product": {
      "type": "object",
      "required": [
        "name",
        "version",
        "source_revision",
        "binary_sha256",
        "dependencies"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "binary_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "binary_identity_note": {
          "type": "string"
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "was_run",
        "utc",
        "argv",
        "exit_code",
        "platform",
        "architecture",
        "runtime",
        "compiler_flags"
      ],
      "properties": {
        "was_run": {
          "type": "boolean"
        },
        "utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "compiler_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "precision": {
      "type": "object",
      "required": [
        "input",
        "arithmetic",
        "output",
        "serialized"
      ],
      "properties": {
        "input": {
          "type": [
            "string",
            "null"
          ]
        },
        "arithmetic": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        },
        "serialized": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "exporter": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "commit"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "corpus": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "profiles",
        "independent_input_count",
        "native_observation_count",
        "quatops_replay_count"
      ],
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "independent_input_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "native_observation_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "quatops_replay_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "state",
        "reviewer",
        "limitations"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_executed",
            "captured_not_reviewed",
            "audited",
            "accepted_for_scope"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_kind": {
            "const": "native_runtime"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "was_run": {
                "const": true
              },
              "exit_code": {
                "type": "integer"
              },
              "utc": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "product": {
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "exporter": {
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "artifacts": {
            "minItems": 1
          },
          "review": {
            "properties": {
              "state": {
                "not": {
                  "const": "not_executed"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_kind": {
            "const": "not_executed"
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "was_run": {
                "const": false
              },
              "exit_code": {
                "type": "null"
              }
            }
          },
          "review": {
            "properties": {
              "state": {
                "const": "not_executed"
              }
            }
          }
        }
      }
    }
  ]
}
