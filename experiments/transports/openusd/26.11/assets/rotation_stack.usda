#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Parent"
    {
        quatd xformOp:orient = (0.9238795325112867, 0, 0, 0.3826834323650898)
        double3 xformOp:translate = (1.25, -2, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Xform "Child"
        {
            double3 xformOp:rotateXYZ = (25, -35, 70)
            double3 xformOp:translate = (-0.75, 1.5, 2.25)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ", "xformOp:translate"]
        }

        def Xform "ResetChild"
        {
            quatd xformOp:orient = (0.8660254037844386, 0.5, 0, 0)
            double3 xformOp:translate = (3, -1, 2)
            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:translate", "xformOp:orient"]
        }
    }

    def Xform "AxisX"
    {
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "AxisY"
    {
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "AxisZ"
    {
        double3 xformOp:translate = (0, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

